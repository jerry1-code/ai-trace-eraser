# Copy to .env and fill in your values.
# The server proxies LLM calls so keys never reach the browser.
# When these are set, users can rewrite without supplying their own key,
# and client-supplied api_base is ignored (SSRF protection).

OPENAI_API_KEY=
# or: DASHSCOPE_API_KEY=

OPENAI_API_BASE=https://api.openai.com/v1
# or: DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

AI_TRACE_MODEL=gpt-4o
# or: qwen-max

PORT=5000

# Debug off in production. Set to 1 only for local development.
AI_TRACE_DEBUG=0
